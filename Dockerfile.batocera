# Debian 12's glibc 2.36 is older than Batocera 42's glibc 2.40.
FROM python:3.12-slim-bookworm AS dependencies
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils libglib2.0-0 libx11-6 libxext6 libxrender1 libgl1 libegl1 \
    libsm6 libice6 libasound2 libpulse0 libxcb1 libxkbcommon0 \
    libxrandr2 libxcursor1 libxi6 libxss1 libxxf86vm1 libdrm2 libgbm1 \
    libdbus-1-3 libudev1 fontconfig \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY requirements.txt /src/requirements.txt
RUN --mount=type=secret,id=flightwall_ca,required=false \
    if [ -s /run/secrets/flightwall_ca ]; then \
        export SSL_CERT_FILE=/run/secrets/flightwall_ca PIP_CERT=/run/secrets/flightwall_ca; \
    fi; \
    python -m pip install --no-cache-dir -r requirements.txt pyinstaller==6.16.0
FROM dependencies AS builder
COPY flightwall /src/flightwall
COPY assets /src/assets
COPY flightwall_entry.py /src/flightwall_entry.py
RUN python -m PyInstaller --clean --noconfirm --onedir --name FlightWall \
    --add-data assets:assets --collect-all pygame --collect-all OpenGL \
    --collect-data tzdata flightwall_entry.py
COPY batocera/collect-licenses.py /src/collect-licenses.py
RUN python /src/collect-licenses.py /src/dist/FlightWall/licenses
CMD ["/src/dist/FlightWall/FlightWall", "--help"]
